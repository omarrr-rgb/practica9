<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Login - CyberNews</title>
  <link rel="stylesheet" href="/styles.css" />
</head>
<body>
  <header class="wrap">
    <h1>CyberNews</h1>
    <p class="subtitle">Autenticación, sesión y CSRF</p>
  </header>

  <main class="wrap narrow">
    <section class="section panel">
      <% if (error) { %>
        <div class="alert" role="alert"><%= error %></div>
      <% } %>

      <form method="POST" action="/login" autocomplete="off">
        <input type="hidden" name="csrf" value="<%= csrf %>" />

        <label class="label" for="username">Usuario</label>
        <input id="username" class="input" name="username" required maxlength="50" autocomplete="username" />

        <label class="label" for="password">Contraseña</label>
        <input id="password" class="input" name="password" type="password" required maxlength="100" autocomplete="current-password" />

        <button class="btn" type="submit">Entrar</button>
      </form>

      <p class="hint">Credenciales exclusivamente didácticas: <code>admin</code> / <code>P@ssw0rd!</code></p>
      <p><a class="link" href="/">Volver a las noticias</a></p>
    </section>
  </main>
</body>
</html>
